{
    "name": "speedyspec/block-builder",
    "version": "0.1.0",
    "description": "SpeedySpec Block System - Reference Builder",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.4",
        "speedyspec/block-domain": "^0.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "speedyspec/block-app": "^0.1",
        "speedyspec/block-infra-memory": "^0.1",
        "speedyspec/block-presentation": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*"
        }
    ],
    "autoload": {
        "psr-4": {
            "SpeedySpec\\Block\\Builder\\": "php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpeedySpec\\Block\\Builder\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/docs",
            "/.github",
            "/.git",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/phpunit.xml",
            "/CHANGELOG.md",
            "/.release-please-manifest.json",
            "/release-please-config.json",
            "/tests",
            "/demo"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
