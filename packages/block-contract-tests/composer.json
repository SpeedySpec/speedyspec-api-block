{
    "name": "speedyspec/block-contract-tests",
    "version": "0.1.0",
    "description": "SpeedySpec Block System - Shared Contract Tests",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.4",
        "speedyspec/block-domain": "^0.1",
        "pestphp/pest": "^3.0|^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*"
        }
    ],
    "autoload": {
        "psr-4": {
            "SpeedySpec\\Block\\ContractTests\\": "src/"
        },
        "files": [
            "src/schemaValidatorContract.php",
            "src/documentRepositoryContract.php",
            "src/dataSourceContract.php"
        ]
    },
    "archive": {
        "exclude": [
            "/docs",
            "/tests",
            "/.github",
            "/.git",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/phpunit.xml",
            "/CHANGELOG.md",
            "/.release-please-manifest.json",
            "/release-please-config.json"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
